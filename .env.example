# ===========================================
# GetFanSee 环境变量配置
# ===========================================
# 复制此文件为 .env.local 并填写你的配置
# cp .env.example .env.local
# ===========================================

# -------------------------------------------
# Supabase 配置（必需）
# -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service Role Key（仅服务端使用，绝不能暴露给客户端）
# 只在 lib/supabase-admin.ts 中使用
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Supabase 个人访问令牌（仅本地 Cursor MCP / CLI，写入 .env.local，勿提交）
# https://supabase.com/dashboard/account/tokens
SUPABASE_PERSONAL_ACCESS_TOKEN=your_supabase_personal_access_token

# -------------------------------------------
# PostHog 行为分析与埋点（P0 数据采集）
# -------------------------------------------
# 从 PostHog 项目设置页面获取 API Key
# https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 自托管时修改此 URL，云版本保持默认
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# -------------------------------------------
# Sentry 错误监控（P1 可观测性）
# -------------------------------------------
# 从 Sentry Dashboard 获取 DSN
# 格式: https://xxx@xxx.ingest.sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=

# Sentry 上传 Source Maps（可选）
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# -------------------------------------------
# Didit KYC 身份验证集成
# -------------------------------------------
# 1. 登录 https://business.didit.me/
# 2. 创建 Organization → Workflows → 选择 KYC template
# 3. Settings → API Keys → 复制 API Key
# 4. API & Webhooks → 设置 Webhook URL 并复制 Secret

# Didit API Key（服务端调用，绝不暴露给前端）
DIDIT_API_KEY=

# Didit Webhook Secret（用于验证 webhook 请求签名）
DIDIT_WEBHOOK_SECRET=

# Didit Workflow ID（从 Console → Workflows 获取）
DIDIT_WORKFLOW_ID=

# -------------------------------------------
# Cron Job 配置
# -------------------------------------------
# 用于验证 Vercel Cron 请求的密钥
# 生成: openssl rand -hex 32
CRON_SECRET=

# -------------------------------------------
# 告警配置
# -------------------------------------------
# Slack Webhook URL（用于金融审计告警）
# 从 Slack App 配置中获取
ALERT_SLACK_WEBHOOK=

# 金融审计阈值
# 交易 pending 超过多少分钟视为卡住
PENDING_STUCK_MINUTES=60
# 一小时内失败交易数超过多少触发告警
FAILED_TXN_THRESHOLD_COUNT=20

# -------------------------------------------
# 测试模式（仅开发/测试环境 — 生产环境必须保持关闭/未设置）
# -------------------------------------------
# ⚠️ 只有服务端 E2E / PLAYWRIGHT_TEST_MODE 可打开测试资金路径；
#    NEXT_PUBLIC_TEST_MODE 仅控制前端测试表现，不能授权充值或消费。
#    这些变量默认注释掉，本地跑 E2E / CI 时再显式设置，避免被误复制到生产 .env。

# 启用测试模式（允许测试账号登录）
# TEST_MODE=true

# 启用 Mock 数据
# USE_MOCK_DATA=true

# Playwright/E2E 测试网关（本地/CI 按需取消注释；生产请勿开启）
# E2E=1
# PLAYWRIGHT_TEST_MODE=true
# NEXT_PUBLIC_TEST_MODE=true
E2E_ALLOW_ANY_HOST=false

# 使用 service-role 运行 E2E/seed 时必须明确钉住专用测试项目。
# E2E_SUPABASE_PROJECT_REF=your-dedicated-test-project-ref
# E2E_TEST_USER_PASSWORD=provide-via-local-env-or-ci-secret

# /api/test/* 额外安全门禁（可选，建议在 CI 设置）
# 调用测试路由时带 header: x-test-secret
TEST_ROUTE_SECRET=

# -------------------------------------------
# 应用配置
# -------------------------------------------
# 基础 URL（用于生成绝对链接）。生产在 DNS 切到 Vercel 之前用 demo 主机。
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://demo.getfansee.com
# After getfansee.com apex DNS points at the Vercel app, set this so
# getPublicSiteUrl() stops remapping the apex to demo.getfansee.com.
# SITE_URL_APEX_LIVE=true

# 服务端年龄门（未配 SECRET 时不要开 ENABLED，否则强法域全站失败关闭）
# AGE_ASSURANCE_ENABLED=true
# AGE_ASSURANCE_SECRET=

# 环境标识
NODE_ENV=development

# -------------------------------------------
# Stripe 支付集成
# -------------------------------------------
# 从 https://dashboard.stripe.com/apikeys 获取
STRIPE_SECRET_KEY=sk_test_...
# 从 https://dashboard.stripe.com/webhooks 获取（webhook signing secret）
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe 前端可用的 publishable key（可选，未来用于 Stripe Elements）
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# -------------------------------------------
# Pre-Payment Alpha 阶段开关
# -------------------------------------------
# Alpha 期（无站内支付）默认即为 true，不设置此变量 = 处于 Alpha。
# Beta 上线开放站内付费后，显式设置为 "false" 以停止自动授予新 KYC 创作者
# Founding Creator 身份（见 lib/kyc/kyc-service.ts、lib/constants/alpha.ts）。
# ALPHA_PHASE=false

# 见 components/paywall-modal.tsx、components/lock-overlay.tsx。
# 必须与 PAYRAM_ENABLED + PAYRAM_API_KEY + PAYRAM_BASE_URL 成对打开。
# 只开本开关会让付费墙可点但无法充值；只开 PayRam 会让粉丝充了钱花不出去。
# lib/payments-live.ts 会在启动时拒绝这种分裂配置。
NEXT_PUBLIC_CRYPTO_TOPUP_ENABLED=false

# -------------------------------------------
# NowPayments 加密货币充值（支线，默认关闭）
# -------------------------------------------
# 生产接入前置条件：完成商务尽调书面确认（地区/主体政策、成人业务政策、实际费率）
# 主开关：仅当为 "true" 时相关 API 才启用
NOWPAYMENTS_ENABLED=false
# sandbox 联调时设为 "true"（使用 api-sandbox.nowpayments.io）
NOWPAYMENTS_SANDBOX=true
# API 密钥（仅 .env.local，绝不入库）
NOWPAYMENTS_API_KEY=
# IPN 回调验签密钥（HMAC-SHA512）
NOWPAYMENTS_IPN_SECRET=

# -------------------------------------------
# PayRam 自托管加密支付（MVP 主通道，默认关闭）
# -------------------------------------------
# 我们自己在 VPS 上跑 PayRam 节点、自己持有冷钱包私钥，因此没有第三方支付商
# 能冻结资金或事后判定我们的行业不可接受。资产锁定为 Base 链上的 USDC 单币单链
# （见 lib/payram.ts 与 docs/planning/payram-phase0-validation.md Gate 2.2）。
#
# 主开关。必须在 Phase 0 小额实钱闭环全部通过后才可置为 "true"；
# isPayramEnabled() 要求 ENABLED + API_KEY + BASE_URL 三者同时齐全。
# 上线时必须同时把 NEXT_PUBLIC_CRYPTO_TOPUP_ENABLED=true，否则充值入口不开。
PAYRAM_ENABLED=false
#
# 自托管实例地址 = PayRam 仪表盘 Settings → Site URL 显示的地址（含端口，若有）。
PAYRAM_BASE_URL=https://pay.example.com
# 项目 API Key（仪表盘按项目生成）。既用于调用 /api/v1/payment，
# 也是 webhook 的 HMAC 签名密钥。仅写 .env.local / 部署环境，绝不入库。
PAYRAM_API_KEY=
# 留空。PayRam 用上面的项目 API Key 签 X-Payram-Signature，
# 只有在实例被单独配置了独立签名密钥时才填此项。
PAYRAM_WEBHOOK_SECRET=
#
# 仪表盘侧还需手工配置（Settings → Webhook → Add Endpoint）：
#   回调地址必须指向【真正跑本仓库的应用域名】+ /api/webhooks/payram。
#   两个容易搞错且都是错的：pay.getfansee.com（PayRam 自己，无此路由）、
#   getfansee.com（顶级域 DNS 仍指向第三方 PHP 候补页，不是本应用）。
#   实际部署是 Vercel 项目 getfansee-auth，通常为 https://demo.getfansee.com。
#   逐步指引：bash scripts/payram/setup-wizard.sh

# -------------------------------------------
# Email（Resend）
# -------------------------------------------
RESEND_API_KEY=
RESEND_FROM_ADDRESS=GetFanSee <noreply@getfansee.com>
